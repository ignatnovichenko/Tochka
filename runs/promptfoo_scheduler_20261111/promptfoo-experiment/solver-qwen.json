{
  "provider": {
    "type": "openai-compatible",
    "base_url": "https://opencode.ai/inference/go/openai/v1",
    "api_key_env": "OPENCODE_GO_API_KEY",
    "timeout_seconds": 120.0,
    "engine": "promptfoo"
  },
  "model": "qwen3.7-plus",
  "configurations": [
    {
      "name": "qwen",
      "parameters": {
        "temperature": 0.0,
        "max_tokens": 4096
      }
    }
  ],
  "repetitions": 1,
  "max_calls": 2
}
