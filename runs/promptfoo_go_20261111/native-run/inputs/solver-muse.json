{
  "provider": {
    "type": "openai-compatible",
    "base_url": "https://opencode.ai/inference/go/openai/v1",
    "api_key_env": "OPENCODE_GO_API_KEY",
    "timeout_seconds": 120.0
  },
  "model": "muse-spark-1.3-contributor",
  "configurations": [
    {
      "name": "muse",
      "parameters": {
        "temperature": 0.0,
        "max_tokens": 1024
      }
    }
  ],
  "repetitions": 1,
  "max_calls": 3
}
